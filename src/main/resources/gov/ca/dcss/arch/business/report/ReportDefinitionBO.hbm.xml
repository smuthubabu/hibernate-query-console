<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="gov.ca.dcss.arch.business.report.ReportDefinitionBO" table="REPORT_DEFINITION" schema="DB2INST1">
        <id name="reportId" column="REPORT_ID" type="long">
            <generator class="increment"/>
        </id>
        <property name="reportName"        column="REPORT_NAME"        type="string" length="100"/>
        <property name="reportDescription" column="REPORT_DESCRIPTION" type="string" length="500"/>
        <property name="reportType"        column="REPORT_TYPE"        type="string" length="50"/>
        <property name="status"            column="STATUS"             type="string" length="20"/>
        <property name="createdDate"       column="CREATED_DATE"       type="timestamp"/>
        <property name="updatedDate"       column="UPDATED_DATE"       type="timestamp"/>
        <property name="createdBy"         column="CREATED_BY"         type="string" length="50"/>
    </class>
</hibernate-mapping>